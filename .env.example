# ── GitHub identity (required) ──────────────────────────────────────────────
# A PAT used to (a) mint short-lived runner registration tokens and (b) dispatch
# workflows from the scheduler.
#   Classic PAT scopes: repo (or admin:org for RUNNER_SCOPE=org)
#   Fine-grained PAT:   Administration:RW (runner registration) + Contents:R
GH_TOKEN=

# ── Runner registration (required, choose one) ──────────────────────────────
# RUNNER_SCOPE=repo  -> register against a single repository
# RUNNER_SCOPE=org   -> register against an organization
RUNNER_SCOPE=repo
GH_REPO=owner/repo
# GH_ORG=your-org

# ── Runner tuning (optional) ────────────────────────────────────────────────
# Custom labels let you target this pool from workflows:
#   runs-on: [self-hosted, cronrunner]
# RUNNER_LABELS=self-hosted,cronrunner
# RUNNER_NAME=my-runner        # defaults to the container hostname