# ── Required ─────────────────────────────────────────────────────────────────
# PAT for runner registration + workflow dispatch.
#   classic: repo; fine-grained: Administration:RW + Actions:RW
GH_TOKEN=

# One repo for both halves: where workflows are dispatched,
# where the runner registers.
GH_REPO=owner/repo

# ── Optional ─────────────────────────────────────────────────────────────────
# RUNNER_NAME=cron-runner                # shown in Settings → Actions → Runners
# RUNNER_LABELS=self-hosted,cron-runner  # default; target the pool with runs-on: