# ── GitHub identity (required) ──────────────────────────────────────────────
# PAT for runner registration + workflow dispatch.
#   Classic: repo (admin:org for RUNNER_SCOPE=org)
#   Fine-grained: Administration:RW + Contents:R
GH_TOKEN=

# ── Runner registration (required, choose one) ──────────────────────────────
RUNNER_SCOPE=repo
GH_REPO=owner/repo
# GH_ORG=your-org

# ── Scheduler (optional) ────────────────────────────────────────────────────
# Pipe-separated cron entries (PaaS path; takes precedence over a mounted
# crontab file):
#   CRONTAB=*/10 * * * * /scheduler/dispatch.sh owner/repo update.yml main
# CRONTAB=

# ── Runner tuning (optional) ────────────────────────────────────────────────
# RUNNER_LABELS=self-hosted,cron-runner
# RUNNER_NAME_PREFIX=cron-runner  # the runner registers under this exact name
# RUNNER_NAME=my-runner           # override the whole name (prefix ignored)
# RUNNER_MAX_LIFETIME=86400       # seconds before a clean self-reset (0 = never)