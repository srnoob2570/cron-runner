# ── GitHub identity (required) ──────────────────────────────────────────────
# A PAT used to (a) mint short-lived runner registration tokens and (b) dispatch
# workflows from the scheduler.
#   Classic PAT scopes: repo (or admin:org for RUNNER_SCOPE=org)
#   Fine-grained PAT:   Administration:RW (runner registration) + Contents:R
GH_TOKEN=

# ── Runner registration (required, choose one) ──────────────────────────────
# RUNNER_SCOPE=repo  -> register against a single repository
# RUNNER_SCOPE=org   -> register against an organization
RUNNER_SCOPE=repo
GH_REPO=owner/repo
# GH_ORG=your-org

# ── Scheduler (optional) ────────────────────────────────────────────────────
# Pipe-separated cron entries. This is the PaaS/Dokploy path (no bind mounts):
#   CRONTAB=*/10 * * * * /scheduler/dispatch.sh workflow owner/repo update.yml main|0 3 * * * /scheduler/dispatch.sh workflow owner/repo nightly.yml develop
# Takes precedence over a mounted crontab file. Leave unset for local compose
# with ./crontab mounted at /etc/crontabs/root.
# CRONTAB=

# ── Runner tuning (optional) ────────────────────────────────────────────────────────────
# Custom labels let you target this pool from workflows:
#   runs-on: [self-hosted, cron-runner]
# RUNNER_LABELS=self-hosted,cron-runner
# RUNNER_NAME_PREFIX=cron-runner  # the runner registers under this exact name
# RUNNER_NAME=my-runner          # override the whole name (prefix ignored)
# RUNNER_MAX_LIFETIME=86400      # seconds before a clean self-reset (0 = never)